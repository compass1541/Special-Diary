# Supabase Configuration (필수)
# 대시보드 > Project Settings > API에서 복사
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini API Key (선택)
# 권장: 비워두고 supabase/functions/ai-proxy로 이전.
# 이 키를 여기에 채우면 dist/ 번들에 그대로 박혀 누구나 추출/도용할 수 있다.
# 로컬 개발용으로만 사용하고 프로덕션 배포 시 제거할 것.
# 키 발급: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
